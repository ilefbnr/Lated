# =============================================================================
# LateD — environment variables template
# =============================================================================
# Copy to .env and fill in actual values.
# Never commit .env to version control.
# =============================================================================

# --- Backend ------------------------------------------------------------------
LATED_ENV=development              # development | staging | production
LATED_LOG_LEVEL=INFO
LATED_API_HOST=0.0.0.0
LATED_API_PORT=8000
LATED_SECRET_KEY=replace-me        # used for signing internal tokens

# --- Detection ----------------------------------------------------------------
LATED_TGNN_MODEL_PATH=/data/models/tgnn_lm.pt
LATED_TGNN_DEVICE=cpu              # cpu | cuda
LATED_DETECTION_THRESHOLD=0.75
LATED_RECON_WINDOW_SECONDS=60

# --- Ingestion ----------------------------------------------------------------
LATED_INGEST_MODE=zeek             # pcap | zeek | netflow
LATED_PCAP_INTERFACE=               # only used in pcap mode (privileged)

# --- Storage ------------------------------------------------------------------
POSTGRES_USER=lated
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
NEO4J_AUTH=neo4j/replace-me

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
